{
  "name": "micro-ct-visualizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:itk-vtk-viewer": "node scripts/sync-itk-vtk-viewer.mjs",
    "predev": "npm run sync:itk-vtk-viewer",
    "dev": "vite",
    "dev:server": "npm run start --prefix server",
    "dev:server:watch": "npm run dev --prefix server",
    "dev:all": "concurrently -n client,server -c green,blue \"npm run dev\" \"npm run dev:server\"",
    "prebuild": "npm run sync:itk-vtk-viewer",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "prod:all": "npm run build && concurrently -n client,server -c green,blue \"npm run preview\" \"npm run dev:server\""
  },
  "dependencies": {
    "itk-vtk-viewer": "^14.51.0",
    "numcodecs": "^0.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "~0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
